DB_HOST=your-mysql-host
DB_PORT=3306
DB_USER=your-mysql-user
DB_PASSWORD=your-mysql-password
DB_NAME=gbv
DB_SSL=true

# Defaults to chat_history and sender_id for the gbv schema.
CHAT_HISTORY_TABLE=chat_history
CHAT_HISTORY_MESSENGER_ID_COLUMN=sender_id

META_PAGE_ID=your-facebook-page-id
META_PAGE_ACCESS_TOKEN=your-page-access-token
META_GRAPH_VERSION=vXX.X

# Choose a long random value. Required to use the website/API.
APP_PASSWORD=replace-with-a-long-random-password